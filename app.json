{
  "expo": {
    "name": "Fluke",
    "slug": "fluke",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icons/android-adaptive-icon-color.png",
    "scheme": "fluke",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/icons/android-adaptive-icon-color.png",
        "monochromeImage": "./assets/icons/android-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.reitansora.fluke",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.CAMERA"
      ]
    },
    "primaryColor": "#FFFFFF",
    "web": {
      "output": "static",
      "favicon": "./assets/icons/android-adaptive-icon-color.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/splash-icon-light.png",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#121212",
            "image": "./assets/splash/splash-icon-dark.png"
          },
          "resizeMode": "cover"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/MPLUS-Bold.ttf",
            "./assets/fonts/MPLUS-ExtraBold.ttf",
            "./assets/fonts/MPLUS-Regular.ttf",
            "./assets/fonts/MPLUS-Medium.ttf",
            "./assets/fonts/MPLUS-Thin.ttf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"],
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-image",
      [
        "expo-camera",
        {
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "89e0595b-e89f-4aa8-997a-74563f7d936c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/89e0595b-e89f-4aa8-997a-74563f7d936c"
    }
  }
}
